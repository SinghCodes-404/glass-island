<Window x:Class="GlassIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:GlassIsland.Core"
        Title="Glass Island"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        Width="520" Height="112" Left="0" Top="0"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"
        FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="{StaticResource TextPrimary}">

    <Window.Resources>
        <!-- Wallpaper tile -->
        <Style x:Key="StarButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="#73000000" />
                            <TextBlock x:Name="G" Style="{StaticResource Icon}" FontSize="11" Text="&#xE734;" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter TargetName="G" Property="Text" Value="&#xE735;" />
                                <Setter TargetName="G" Property="Foreground" Value="#FFFFD25E" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Width" Value="119" />
            <Setter Property="Margin" Value="0,0,8,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Command" Value="{Binding DataContext.Walls.ApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Background="Transparent">
                            <Grid x:Name="Thumb" Height="68" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                                <!-- one element paints the preview, its rounded corners and the hairline edge -->
                                <Border x:Name="Img" CornerRadius="12" BorderBrush="#26FFFFFF" BorderThickness="1">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Border CornerRadius="12" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2.5"
                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                                <Border CornerRadius="6" Background="#8C000000" Padding="6,1,6,2" Margin="6"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding TypeLabel}" FontSize="9" FontWeight="SemiBold" Foreground="#E6FFFFFF" />
                                </Border>
                                <Button x:Name="Star" Style="{StaticResource StarButton}" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Opacity="0" Command="{Binding DataContext.Walls.FavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                            <TextBlock Text="{Binding Title}" FontSize="11" Margin="3,6,3,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextSecondary}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.05" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.05" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="Star" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetName="Star" Storyboard.TargetProperty="Opacity" Duration="0:0:0.2" />
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter TargetName="Star" Property="Opacity" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Thumb}" Value="{x:Null}">
                                <Setter TargetName="Img" Property="Background" Value="#14FFFFFF" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- empty slot at the end of the last row -->
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="2" Opacity="0" />
                            <Ellipse Margin="4" Fill="{Binding Brush}" />
                            <Ellipse Margin="4" StrokeThickness="1">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#80FFFFFF" Offset="0" /><GradientStop Color="#10FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="0.95" /></DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}" /></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Height" Value="28" />
        </Style>

        <!-- 15 fps with eased, slightly slower strokes: reads as fluid, costs a fraction of 60 fps. -->
        <SineEase x:Key="BarEase" EasingMode="EaseInOut" />
        <Storyboard x:Key="Visualizer" RepeatBehavior="Forever" Timeline.DesiredFrameRate="15">
            <DoubleAnimation Storyboard.TargetName="Bar1" Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.3" To="1" Duration="0:0:0.52" AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource BarEase}" />
            <DoubleAnimation Storyboard.TargetName="Bar2" Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.9" To="0.25" Duration="0:0:0.44" AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource BarEase}" />
            <DoubleAnimation Storyboard.TargetName="Bar3" Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.4" To="0.95" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource BarEase}" />
            <DoubleAnimation Storyboard.TargetName="Bar4" Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.75" To="0.2" Duration="0:0:0.38" AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource BarEase}" />
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Only used when rendering design snapshots -->
        <Image x:Name="SnapshotBg" Stretch="Fill" Visibility="Collapsed" />

        <!-- Soft contact shadow -->
        <!-- Soft contact shadow, built from stacked translucent shapes: no blur effect to re-render while the island morphs -->
        <Grid x:Name="ShadowBox" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,15,0,0"
              Opacity="0.42" IsHitTestVisible="False" Width="160" Height="34">
            <Border x:Name="Shadow3" Margin="-12,-6,-12,-14" Background="#14000000" />
            <Border x:Name="Shadow2" Margin="-7,-3,-7,-8" Background="#24000000" />
            <Border x:Name="Shadow1" Margin="-3,-1,-3,-3" Background="#3A000000" />
        </Grid>

        <Grid x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
              Width="168" Height="34" Background="#01000000"
              MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave" MouseLeftButtonUp="Island_MouseLeftButtonUp">
            <Grid.Clip>
                <RectangleGeometry x:Name="IslandClip" Rect="0,0,168,34" RadiusX="17" RadiusY="17" />
            </Grid.Clip>

            <!-- 1. refracted, blurred backdrop -->
            <Canvas x:Name="BackdropHost" IsHitTestVisible="False">
                <Image x:Name="BackdropImg" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="LensScale" ScaleX="1.04" ScaleY="1.04" />
                    </Image.RenderTransform>
                </Image>
            </Canvas>

            <!-- 2. tint keeps text legible on any background (opacity adapts to backdrop luminance) -->
            <Border x:Name="Tint" Background="#FF07080C" Opacity="0.42" CornerRadius="17" IsHitTestVisible="False" />

            <!-- 3. top sheen -->
            <Border x:Name="Sheen" CornerRadius="17" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#24FFFFFF" Offset="0" />
                        <GradientStop Color="#06FFFFFF" Offset="0.45" />
                        <GradientStop Color="#00FFFFFF" Offset="0.7" />
                        <GradientStop Color="#0AFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 4. content -->
            <Canvas x:Name="ContentCanvas">

                <!-- ===== Collapsed pill ===== -->
                <Grid x:Name="CollapsedLayer" Width="168" Height="34">
                    <Grid x:Name="PillIdle" Margin="16,0">
                        <TextBlock Text="{Binding Time}" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Date}" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <Ellipse Width="6" Height="6" Margin="8,0,0,0" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PillMusic" Margin="5,0,14,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="PillArt" Width="26" Height="26" VerticalAlignment="Center" Background="Transparent" Cursor="Hand"
                              MouseLeftButtonUp="PillArt_Click" ToolTip="Open the player">
                            <Rectangle RadiusX="8" RadiusY="8" Fill="{Binding Media.ArtBrush}" />
                            <Rectangle RadiusX="8" RadiusY="8" RenderOptions.BitmapScalingMode="HighQuality">
                                <Rectangle.Fill><ImageBrush ImageSource="{Binding Media.Art}" Stretch="UniformToFill" /></Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                        <TextBlock x:Name="PillTitle" Grid.Column="1" Text="{Binding Media.Title}" Margin="10,0,8,0" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0" />
                        <StackPanel x:Name="Bars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="16">
                            <Rectangle x:Name="Bar1" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="{Binding Media.ArtBrush}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle x:Name="Bar2" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="{Binding Media.ArtBrush}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.8" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle x:Name="Bar3" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="{Binding Media.ArtBrush}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.55" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle x:Name="Bar4" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="{Binding Media.ArtBrush}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PillTimer" Margin="6,0,15,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="24" Height="24" VerticalAlignment="Center">
                            <Ellipse Stroke="#33FFFFFF" StrokeThickness="3" Margin="1.5" />
                            <Path Data="{Binding Focus.Progress, Converter={StaticResource Arc}, ConverterParameter='24,3'}" Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <TextBlock x:Name="PillTimerTitle" Grid.Column="1" Text="Focus" Margin="10,0,8,0" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Opacity="0" />
                        <TextBlock Grid.Column="2" Text="{Binding Focus.RemainingText}" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                    </Grid>
                </Grid>

                <!-- ===== Tucked: a slim line, like the iPhone home indicator ===== -->
                <Grid x:Name="LineLayer" Width="72" Height="5" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                    <Rectangle x:Name="LineBase" Fill="#B3FFFFFF" />
                    <Rectangle x:Name="LineFill" HorizontalAlignment="Left" Width="0" Fill="{DynamicResource AccentBrush}" />
                </Grid>

                <!-- ===== Live activity / toast ===== -->
                <Grid x:Name="ToastLayer" Width="340" Height="48" Opacity="0" Visibility="Collapsed">
                    <Grid Margin="8,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="34" Height="34" VerticalAlignment="Center">
                            <Border x:Name="ToastGlyphHost" CornerRadius="17" Background="{DynamicResource AccentBrush}">
                                <TextBlock x:Name="ToastGlyph" Style="{StaticResource Icon}" FontSize="15" Foreground="White" />
                            </Border>
                            <Rectangle x:Name="ToastImage" RadiusX="10" RadiusY="10" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality">
                                <Rectangle.Fill><ImageBrush x:Name="ToastImageBrush" Stretch="UniformToFill" /></Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ToastTitle" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ToastSub" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ===== Expanded panel ===== -->
                <Grid x:Name="ExpandedLayer" Width="680" Height="212" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform><ScaleTransform x:Name="ExpandScale" /></Grid.RenderTransform>
                    <Grid Margin="16,14,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" /><RowDefinition Height="12" /><RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header: tabs + clock.
                             Static content is bitmap-cached per panel: the expand scale, tab fades and glass refreshes
                             then only re-composite textures instead of re-rendering text and shapes every frame. -->
                        <Grid>
                            <Grid.CacheMode><BitmapCache SnapsToDevicePixels="True" /></Grid.CacheMode>
                            <Grid x:Name="TabHost" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border x:Name="TabIndicator" HorizontalAlignment="Left" Height="30" Width="80" CornerRadius="15"
                                        Background="{StaticResource GlassFillStrong}" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1">
                                    <Border.RenderTransform><TranslateTransform x:Name="TabIndicatorX" /></Border.RenderTransform>
                                </Border>
                                <StackPanel x:Name="TabBar" Orientation="Horizontal">
                                    <Button x:Name="TabHome" Style="{StaticResource TabButton}" Click="Tab_Click">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><TextBlock Text="Home" Margin="7,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                                    </Button>
                                    <Button x:Name="TabWalls" Style="{StaticResource TabButton}" Click="Tab_Click">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE91B;" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><TextBlock Text="Wallpapers" Margin="7,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                                    </Button>
                                    <Button x:Name="TabTheme" Style="{StaticResource TabButton}" Click="Tab_Click">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE790;" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><TextBlock Text="Theme" Margin="7,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                                    </Button>
                                    <Button x:Name="TabFocus" Style="{StaticResource TabButton}" Click="Tab_Click">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE916;" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><TextBlock Text="Focus" Margin="7,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                                    </Button>
                                    <Button x:Name="TabAsk" Style="{StaticResource TabButton}" Click="Tab_Click">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE99A;" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><TextBlock Text="Ask" Margin="7,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Date}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Time}" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold" Margin="8,0,10,0" VerticalAlignment="Center" />
                                <Button Style="{StaticResource GlassIconButton}" Width="30" Height="30" FontSize="11" Content="&#xE70E;" Click="Collapse_Click" ToolTip="Collapse (Esc)" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="Body" Grid.Row="2">

                            <!-- ================= HOME ================= -->
                            <Grid x:Name="HomePanel">
                                <Grid.CacheMode><BitmapCache SnapsToDevicePixels="True" /></Grid.CacheMode>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="256" /><ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="172" />
                                </Grid.ColumnDefinitions>

                                <!-- Now playing -->
                                <Border Style="{StaticResource Card}" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid Width="98" Height="98" VerticalAlignment="Center">
                                            <Rectangle RadiusX="16" RadiusY="16">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#40FFFFFF" Offset="0" /><GradientStop Color="#10FFFFFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="30" Foreground="{StaticResource TextTertiary}"
                                                       Visibility="{Binding Media.Art, Converter={StaticResource InvNullToVis}}" />
                                            <Rectangle RadiusX="16" RadiusY="16" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Rectangle.Fill><ImageBrush ImageSource="{Binding Media.Art}" Stretch="UniformToFill" /></Rectangle.Fill>
                                            </Rectangle>
                                            <Rectangle RadiusX="16" RadiusY="16" Stroke="#26FFFFFF" StrokeThickness="1" />
                                            <!-- hover: "open the player" -->
                                            <Border CornerRadius="16" Background="#73000000" Cursor="Hand" MouseLeftButtonUp="OpenPlayer_Click"
                                                    Visibility="{Binding Media.HasMedia, Converter={StaticResource BoolToVis}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1" /></Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="18" />
                                                    <TextBlock Text="Open" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OpenPlayer_Click" ToolTip="Open the player">
                                                <TextBlock Text="{Binding Media.Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Media.Artist}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Media.HasMedia, Converter={StaticResource BoolToVis}}">
                                                    <Run Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="9" /><Run Text="  " /><Run Text="{Binding Media.SourceName, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="-4,12,0,0">
                                                <Button Style="{StaticResource PlainIconButton}" Width="32" Height="32" FontSize="13" Content="&#xE892;" Command="{Binding Media.PreviousCommand}" />
                                                <Button Style="{StaticResource SolidIconButton}" Width="38" Height="38" FontSize="14" Margin="6,0" Command="{Binding Media.TogglePlayCommand}">
                                                    <Grid>
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE769;" Foreground="#FF101114" Visibility="{Binding Media.IsPlaying, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Foreground="#FF101114" Visibility="{Binding Media.IsPlaying, Converter={StaticResource InvBoolToVis}}" />
                                                    </Grid>
                                                </Button>
                                                <Button Style="{StaticResource PlainIconButton}" Width="32" Height="32" FontSize="13" Content="&#xE893;" Command="{Binding Media.NextCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Calendar + next task -->
                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,10">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Month}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Week}" HorizontalAlignment="Right" Focusable="False">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Width="23">
                                                            <TextBlock Text="{Binding Letter}" FontSize="9" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" />
                                                            <Grid Width="22" Height="22" Margin="0,2,0,0">
                                                                <Ellipse Fill="{DynamicResource AccentBrush}" Visibility="{Binding IsToday, Converter={StaticResource BoolToVis}}" />
                                                                <TextBlock x:Name="N" Text="{Binding Number}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                                                            </Grid>
                                                        </StackPanel>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter TargetName="N" Property="Foreground" Value="White" />
                                                                <Setter TargetName="N" Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                        <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource Hairline}" Margin="0,9,0,8" />
                                        <Grid Grid.Row="2">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Focus.NextTodoText}" Margin="9,0,0,0" FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                <Button Style="{StaticResource PillButton}" Height="28" Padding="11,0" Command="{Binding Focus.QuickStartCommand}"
                                                        Visibility="{Binding Focus.IsActive, Converter={StaticResource InvBoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="10" Foreground="White" />
                                                        <TextBlock Margin="7,0,0,0" Foreground="White" FontWeight="SemiBold"><Run Text="{Binding Focus.Minutes, Mode=OneWay}" /><Run Text=" min focus" /></TextBlock>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostPillButton}" Height="28" Padding="11,0" Command="{Binding Focus.ToggleCommand}"
                                                        Visibility="{Binding Focus.IsActive, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Focus.ToggleGlyph}" FontSize="10" />
                                                        <TextBlock Margin="7,0,0,0" Text="{Binding Focus.RemainingText}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Quick toggles -->
                                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="9">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <UniformGrid Rows="2" Columns="2" Margin="-3">
                                            <ToggleButton Style="{StaticResource ToggleTile}" Margin="3" Height="40" IsChecked="{Binding Theme.IsDark, Mode=TwoWay}" ToolTip="Windows dark mode">
                                                <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="13" /><TextBlock Text="Dark" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" /></StackPanel>
                                            </ToggleButton>
                                            <ToggleButton Style="{StaticResource ToggleTile}" Margin="3" Height="40" IsChecked="{Binding IsMuted, Mode=TwoWay}" ToolTip="Mute system audio">
                                                <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE74F;" FontSize="13" /><TextBlock Text="Mute" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" /></StackPanel>
                                            </ToggleButton>
                                            <ToggleButton Style="{StaticResource ToggleTile}" Margin="3" Height="40" IsChecked="{Binding Walls.IsPaused, Mode=OneWay}" Command="{Binding Walls.PauseCommand}" ToolTip="Pause live wallpaper">
                                                <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE769;" FontSize="13" /><TextBlock Text="Still" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" /></StackPanel>
                                            </ToggleButton>
                                            <ToggleButton Style="{StaticResource ToggleTile}" Margin="3" Height="40" IsChecked="{Binding Theme.MatchWallpaper, Mode=TwoWay}" ToolTip="Match accent color to wallpaper">
                                                <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE790;" FontSize="13" /><TextBlock Text="Match" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" /></StackPanel>
                                            </ToggleButton>
                                        </UniformGrid>
                                        <Grid Grid.Row="1" Margin="2,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                            <Slider Grid.Column="1" Style="{StaticResource GlassSlider}" Margin="8,0,2,0" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- ================= WALLPAPERS ================= -->
                            <Grid x:Name="WallPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="196" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="SearchBox" Style="{StaticResource GlassTextBox}" Tag="Search wallpapers" core:Glyph.Value="&#xE721;"
                                             Text="{Binding Walls.Search, UpdateSourceTrigger=PropertyChanged, Delay=180}" />
                                    <Border Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" CornerRadius="100" Background="#10FFFFFF" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Chip}" Content="All" Command="{Binding Walls.FilterCommand}" CommandParameter="All"
                                                    Tag="{Binding Walls.Filter, Converter={StaticResource Eq}, ConverterParameter=All}" />
                                            <Button Style="{StaticResource Chip}" Content="Favorites" Command="{Binding Walls.FilterCommand}" CommandParameter="Favorites"
                                                    Tag="{Binding Walls.Filter, Converter={StaticResource Eq}, ConverterParameter=Favorites}" />
                                            <Button Style="{StaticResource Chip}" Content="Recent" Command="{Binding Walls.FilterCommand}" CommandParameter="Recent"
                                                    Tag="{Binding Walls.Filter, Converter={StaticResource Eq}, ConverterParameter=Recent}"
                                                    Visibility="{Binding Walls.IsEngine, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Border CornerRadius="100" Background="#10FFFFFF" Padding="2" Margin="0,0,8,0" ToolTip="Apply to monitor"
                                                Visibility="{Binding Walls.HasMultipleMonitors, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="8,0,2,0" />
                                                <ItemsControl ItemsSource="{Binding Walls.MonitorOptions}" Focusable="False">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource Chip}" Padding="9,0" Content="{Binding}" CommandParameter="{Binding}"
                                                                    Command="{Binding DataContext.Walls.MonitorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Loaded="MonitorChip_Loaded" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <Button Style="{StaticResource GlassIconButton}" Width="32" Height="32" FontSize="13" Content="&#xE8B1;" Command="{Binding Walls.ShuffleCommand}" ToolTip="Shuffle" />
                                        <Button Style="{StaticResource GlassIconButton}" Width="32" Height="32" FontSize="13" Margin="6,0,0,0" Command="{Binding Walls.PauseCommand}" ToolTip="Pause / play wallpaper"
                                                Visibility="{Binding Walls.IsEngine, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE769;" Visibility="{Binding Walls.IsPaused, Converter={StaticResource InvBoolToVis}}" />
                                                <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE768;" Visibility="{Binding Walls.IsPaused, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource GlassIconButton}" Width="32" Height="32" FontSize="13" Margin="6,0,0,0" Command="{Binding Walls.MuteCommand}" ToolTip="Mute wallpaper audio"
                                                Visibility="{Binding Walls.IsEngine, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE767;" Visibility="{Binding Walls.IsMuted, Converter={StaticResource InvBoolToVis}}" />
                                                <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE74F;" Visibility="{Binding Walls.IsMuted, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="2,10,2,8">
                                    <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" MaxWidth="460" HorizontalAlignment="Left">
                                        <Run Text="Now showing  " /><Run Text="{Binding Walls.CurrentTitle, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Right">
                                        <Run Text="{Binding Walls.Service.SourceName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Walls.Status, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>

                                <ItemsControl x:Name="WallList" Grid.Row="2" ItemsSource="{Binding Walls.Rows}" Focusable="False"
                                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                              VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0.5" VirtualizingPanel.CacheLengthUnit="Page"
                                              ScrollViewer.CanContentScroll="True">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer x:Name="WallScroll" Style="{StaticResource GlassScrollViewer}" CanContentScroll="True">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource TileButton}" DataContext="{Binding Item0}" />
                                                <Button Style="{StaticResource TileButton}" DataContext="{Binding Item1}" />
                                                <Button Style="{StaticResource TileButton}" DataContext="{Binding Item2}" />
                                                <Button Style="{StaticResource TileButton}" DataContext="{Binding Item3}" />
                                                <Button Style="{StaticResource TileButton}" DataContext="{Binding Item4}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="WallEmpty" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE91B;" FontSize="26" Foreground="{StaticResource TextTertiary}" />
                                    <TextBlock Text="{Binding Walls.Status}" Margin="0,10,0,0" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- ================= THEME ================= -->
                            <Grid x:Name="ThemePanel" Visibility="Collapsed">
                                <Grid.CacheMode><BitmapCache SnapsToDevicePixels="True" /></Grid.CacheMode>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="248" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="14,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="Appearance" />
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border CornerRadius="100" Background="#10FFFFFF" Padding="2">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource Chip}" Command="{Binding Theme.ModeCommand}" CommandParameter="Light"
                                                            Tag="{Binding Theme.Mode, Converter={StaticResource Eq}, ConverterParameter=Light}">
                                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><TextBlock Text="Light" Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource Chip}" Command="{Binding Theme.ModeCommand}" CommandParameter="Dark"
                                                            Tag="{Binding Theme.Mode, Converter={StaticResource Eq}, ConverterParameter=Dark}">
                                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><TextBlock Text="Dark" Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource Chip}" Command="{Binding Theme.ModeCommand}" CommandParameter="Auto"
                                                            Tag="{Binding Theme.Mode, Converter={StaticResource Eq}, ConverterParameter=Auto}">
                                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><TextBlock Text="Auto" Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Theme.AutoHint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Style="{StaticResource SectionTitle}" Text="Accent color" Margin="0,16,0,0" />
                                        <ItemsControl Grid.Row="3" ItemsSource="{Binding Theme.Swatches}" Margin="-2,8,0,0" Focusable="False">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource SwatchButton}" CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.Theme.AccentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Grid.Row="4" Style="{StaticResource SettingRow}" Margin="0,10,0,0">
                                            <TextBlock Text="Match accent to wallpaper" VerticalAlignment="Center" />
                                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Theme.MatchWallpaper, Mode=TwoWay}" />
                                        </Grid>
                                        <Grid Grid.Row="5" Style="{StaticResource SettingRow}">
                                            <TextBlock Text="Transparency effects" VerticalAlignment="Center" />
                                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Theme.Transparency, Mode=TwoWay}" />
                                        </Grid>
                                        <Grid Grid.Row="6" Style="{StaticResource SettingRow}">
                                            <TextBlock Text="Accent on taskbar" VerticalAlignment="Center" />
                                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Theme.AccentOnTaskbar, Mode=TwoWay}" />
                                        </Grid>
                                        <Grid Grid.Row="7" Style="{StaticResource SettingRow}">
                                            <TextBlock Text="Rotate wallpaper" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource GhostPillButton}" Height="24" Padding="10,0" FontSize="11" HorizontalAlignment="Right"
                                                    Command="{Binding Theme.RotateCommand}" Content="{Binding Theme.RotateLabel}" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,8">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="Island" Margin="0,4,0,4" />
                                        <Grid Style="{StaticResource SettingRow}">
                                            <TextBlock Text="Tuck into a line after" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource GhostPillButton}" Height="24" Padding="10,0" FontSize="11" HorizontalAlignment="Right"
                                                    Command="{Binding Theme.TuckCommand}" Content="{Binding Theme.TuckLabel}" ToolTip="How long the pill stays before it gets out of your way" />
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <TextBlock Text="When tucked, show" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource GhostPillButton}" Height="24" Padding="10,0" FontSize="11" HorizontalAlignment="Right"
                                                    Command="{Binding Theme.TuckStyleCommand}" Content="{Binding Theme.TuckStyleLabel}" ToolTip="A slim line, or nothing at all (hover the top edge to bring it back)" />
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <TextBlock Text="Hide in fullscreen apps" VerticalAlignment="Center" />
                                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Theme.HideInFullscreen, Mode=TwoWay}" />
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}" ToolTip="When a player only gives a tiny thumbnail (Firefox, browsers), look up sharp 600 px artwork on iTunes. Sends the song title and artist to Apple's search API.">
                                            <TextBlock Text="HD album art (iTunes)" VerticalAlignment="Center" />
                                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Theme.OnlineArtwork, Mode=TwoWay}" />
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <TextBlock Text="Liquid glass" VerticalAlignment="Center" />
                                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Theme.LiquidGlass, Mode=TwoWay}" />
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <TextBlock Text="Start with Windows" VerticalAlignment="Center" />
                                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Theme.StartWithWindows, Mode=TwoWay}" />
                                        </Grid>
                                        <Rectangle Height="1" Fill="{StaticResource Hairline}" Margin="0,4,0,6" />
                                        <Grid Style="{StaticResource SettingRow}">
                                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                                                <Run Text="{Binding Hotkey, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" /><Run Text="  opens it" />
                                            </TextBlock>
                                            <Button Style="{StaticResource GhostPillButton}" Height="24" Padding="10,0" FontSize="11" HorizontalAlignment="Right" Click="Quit_Click">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="10" /><TextBlock Text="Quit" Margin="6,0,0,0" /></StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ================= FOCUS ================= -->
                            <Grid x:Name="FocusPanel" Visibility="Collapsed">
                                <Grid.CacheMode><BitmapCache SnapsToDevicePixels="True" /></Grid.CacheMode>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="262" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="14,12">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid Width="116" Height="116" VerticalAlignment="Center">
                                                <Ellipse Stroke="#1FFFFFFF" StrokeThickness="8" Margin="4" />
                                                <Path Data="{Binding Focus.Progress, Converter={StaticResource Arc}, ConverterParameter='116,8'}" Stroke="{DynamicResource AccentBrush}"
                                                      StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Focus.RemainingText}" FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                                    <TextBlock Text="focus" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                                <Button Style="{StaticResource PillButton}" Command="{Binding Focus.ToggleCommand}" HorizontalAlignment="Stretch">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Focus.ToggleGlyph}" FontSize="11" Foreground="White" />
                                                        <TextBlock Text="{Binding Focus.ToggleLabel}" Margin="7,0,0,0" Foreground="White" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostPillButton}" Command="{Binding Focus.ResetCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="11" />
                                                        <TextBlock Text="Reset" Margin="7,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <Border Grid.Row="1" CornerRadius="100" Background="#10FFFFFF" Padding="2" HorizontalAlignment="Left" Margin="0,10,0,0">
                                            <ItemsControl ItemsSource="{Binding Focus.Presets}" Focusable="False">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource Chip}" Padding="12,0" CommandParameter="{Binding}" Loaded="PresetChip_Loaded"
                                                                Command="{Binding DataContext.Focus.PresetCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <TextBlock><Run Text="{Binding Mode=OneWay}" /><Run Text=" min" /></TextBlock>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="Tasks" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Focus.TodoSummary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBox x:Name="TodoBox" Grid.Row="1" Margin="0,8,0,6" Style="{StaticResource GlassTextBox}" Tag="Add a task, press Enter"
                                                 core:Glyph.Value="&#xE710;" Text="{Binding Focus.NewTodo, UpdateSourceTrigger=PropertyChanged}" KeyDown="TodoBox_KeyDown" />
                                        <ScrollViewer Grid.Row="2" Style="{StaticResource GlassScrollViewer}">
                                            <ItemsControl ItemsSource="{Binding Focus.Todos}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid x:Name="Row" Height="30" Background="Transparent">
                                                            <CheckBox Style="{StaticResource TodoCheck}" IsChecked="{Binding Done, Mode=TwoWay}" Margin="2,0,30,0" VerticalAlignment="Center">
                                                                <TextBlock x:Name="T" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                                            </CheckBox>
                                                            <Button x:Name="Del" Style="{StaticResource PlainIconButton}" Width="24" Height="24" FontSize="9" Content="&#xE711;"
                                                                    HorizontalAlignment="Right" Opacity="0" CommandParameter="{Binding}"
                                                                    Command="{Binding DataContext.Focus.RemoveTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Done}" Value="True">
                                                                <Setter TargetName="T" Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter TargetName="T" Property="Foreground" Value="{StaticResource TextTertiary}" />
                                                            </DataTrigger>
                                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Del" Property="Opacity" Value="1" />
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="Your list is empty. Add what matters today."
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="TodoEmpty" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- ================= ASK (Gemini) ================= -->
                            <Grid x:Name="AskPanel" Visibility="Collapsed">

                                <!-- first run: connect a key -->
                                <Border Style="{StaticResource Card}" Padding="24,18" Visibility="{Binding Assistant.HasKey, Converter={StaticResource InvBoolToVis}}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="430">
                                        <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE99A;" FontSize="20" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="Connect Gemini" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" FontSize="11.5"
                                                   Text="Paste an API key from Google AI Studio. It's encrypted with Windows on this PC (DPAPI) and only ever sent to Google." />
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="KeyBox" Style="{StaticResource GlassPasswordBox}" KeyDown="KeyBox_KeyDown" PasswordChanged="KeyBox_PasswordChanged" />
                                            <TextBlock x:Name="KeyPlaceholder" Text="Paste your Gemini API key" Foreground="{StaticResource TextTertiary}" Margin="15,0,0,0"
                                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                                            <Button Grid.Column="1" Style="{StaticResource PillButton}" Height="34" Margin="8,0,0,0" Content="Connect" Click="SaveKey_Click"
                                                    IsEnabled="{Binding Assistant.IsValidating, Converter={StaticResource Not}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Assistant.KeyStatus}" Style="{StaticResource Caption}" Foreground="#FFFF9A94" TextWrapping="Wrap"
                                                   TextAlignment="Center" Margin="0,8,0,0" />
                                        <Button Style="{StaticResource Chip}" HorizontalAlignment="Center" Margin="0,6,0,0" Command="{Binding Assistant.GetKeyCommand}">
                                            <TextBlock><Run Text="Get a free key at aistudio.google.com  " /><Run Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="9" /></TextBlock>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- chat -->
                                <Grid Visibility="{Binding Assistant.HasKey, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <ScrollViewer x:Name="ChatScroll" Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl ItemsSource="{Binding Assistant.Messages}" Focusable="False" Margin="0,0,4,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel x:Name="Wrap" HorizontalAlignment="Left" MaxWidth="500" Margin="0,0,0,10">
                                                        <Border x:Name="Bubble" CornerRadius="16" Padding="13,8,13,9" Background="{StaticResource CardFill}"
                                                                BorderBrush="{StaticResource GlassStroke}" BorderThickness="1" HorizontalAlignment="Left">
                                                            <Grid>
                                                                <TextBlock core:RichText.Markdown="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" />
                                                                <TextBlock x:Name="Thinking" Text="Thinking…" Style="{StaticResource Caption}" FontSize="12" Visibility="Collapsed" />
                                                            </Grid>
                                                        </Border>
                                                        <ItemsControl ItemsSource="{Binding Actions}" Focusable="False">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border CornerRadius="100" Background="{DynamicResource AccentSoftBrush}" Padding="8,2,10,3" Margin="0,5,5,0">
                                                                        <TextBlock FontSize="10.5"><Run Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="9" /><Run Text="  " /><Run Text="{Binding Mode=OneWay}" /></TextBlock>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                            <Setter TargetName="Wrap" Property="HorizontalAlignment" Value="Right" />
                                                            <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                                            <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                            <Setter TargetName="Bubble" Property="BorderBrush" Value="#33FFFFFF" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter TargetName="Bubble" Property="Background" Value="#33FF5F57" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsStreaming}" Value="True" />
                                                                <Condition Binding="{Binding Text}" Value="" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="Thinking" Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- empty chat: what it can do -->
                                    <StackPanel x:Name="AskEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE99A;" FontSize="26" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="Ask Glass Island anything" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,3" />
                                        <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" Text="It can change your wallpaper, theme, music, focus timer and tasks for you." />
                                        <ItemsControl ItemsSource="{Binding Assistant.Suggestions}" Focusable="False" Margin="0,14,0,0" HorizontalAlignment="Center" MaxWidth="560">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}" Margin="3" Padding="12,0" Height="30" CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.Assistant.SendCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource GhostPillButton}">
                                                                <Setter Property="FontWeight" Value="Normal" />
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="AskBox" Style="{StaticResource GlassTextBox}" Height="36" Tag="Ask anything, or tell it what to change…" core:Glyph.Value="&#xE99A;"
                                                 Text="{Binding Assistant.Input, UpdateSourceTrigger=PropertyChanged}" KeyDown="AskBox_KeyDown" />
                                        <Button Grid.Column="1" Style="{StaticResource PillButton}" Width="36" Height="36" Padding="0" Margin="8,0,0,0" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                Content="&#xE724;" Command="{Binding Assistant.SendCommand}" ToolTip="Send (Enter)"
                                                Visibility="{Binding Assistant.IsBusy, Converter={StaticResource InvBoolToVis}}" />
                                        <Button Grid.Column="1" Style="{StaticResource GhostPillButton}" Width="36" Height="36" Padding="0" Margin="8,0,0,0" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                Content="&#xE71A;" Command="{Binding Assistant.StopCommand}" ToolTip="Stop"
                                                Visibility="{Binding Assistant.IsBusy, Converter={StaticResource BoolToVis}}" />
                                        <Button Grid.Column="2" Style="{StaticResource GlassIconButton}" Width="36" Height="36" Margin="6,0,0,0" FontSize="13"
                                                Content="&#xE710;" Command="{Binding Assistant.NewChatCommand}" ToolTip="New chat" />
                                    </Grid>
                                    <Grid Grid.Row="2" Margin="4,7,4,0">
                                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                                            <Run Text="&#xE99A;" FontFamily="{StaticResource IconFont}" FontSize="9" /><Run Text="  " /><Run Text="{Binding Assistant.ModelLabel, Mode=OneWay}" /><Run Text="  ·  can make mistakes" />
                                        </TextBlock>
                                        <Button Style="{StaticResource Chip}" Height="22" Padding="8,0" FontSize="10.5" HorizontalAlignment="Right" Content="Remove key"
                                                Command="{Binding Assistant.ForgetKeyCommand}" ToolTip="Delete the stored API key from this PC" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Canvas>

            <!-- 5. edge light: soft inner glow + crisp specular rim (the "liquid" edge) -->
            <Border x:Name="InnerGlow" CornerRadius="17" BorderThickness="2.5" Opacity="0.3" IsHitTestVisible="False">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#55FFFFFF" Offset="0" />
                        <GradientStop Color="#08FFFFFF" Offset="0.35" />
                        <GradientStop Color="#05FFFFFF" Offset="0.65" />
                        <GradientStop Color="#33FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>
            <Border x:Name="Rim" CornerRadius="17" BorderThickness="1" IsHitTestVisible="False" Panel.ZIndex="1">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                        <GradientStop Color="#A6FFFFFF" Offset="0" />
                        <GradientStop Color="#26FFFFFF" Offset="0.3" />
                        <GradientStop Color="#0DFFFFFF" Offset="0.6" />
                        <GradientStop Color="#40FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>
        </Grid>

        <!-- While tucked: an invisible strip along the top edge (alpha 1/255 so it still catches the mouse). -->
        <Border x:Name="HotZone" HorizontalAlignment="Center" VerticalAlignment="Top" Width="260" Height="14"
                Background="#01000000" Visibility="Collapsed" Cursor="Hand"
                MouseEnter="HotZone_MouseEnter" MouseLeftButtonUp="HotZone_MouseLeftButtonUp" />
    </Grid>
</Window>
